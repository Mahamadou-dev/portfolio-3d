# ------------------------------------------------------------------
# Portfolio Gremah — variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs.
# ------------------------------------------------------------------

# --- MongoDB Atlas -------------------------------------------------
# 1. Atlas > Database > Connect > Drivers : copier l'URI.
# 2. Coller l'URI tel quel (les placeholders <username>/<password> sont
#    remplaces automatiquement par les deux variables suivantes).
MONGODB_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=
# Nom de la base (creee automatiquement au premier ecrit).
MONGODB_DB=portfolio

# --- Acces au tableau de bord /admin -------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Chaine aleatoire de 32+ caracteres. Generer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# --- Analytique ----------------------------------------------------
# Sel utilise pour hacher les IP des visiteurs (jamais stockees en clair).
# Le changer reinitialise le comptage des visiteurs uniques.
ANALYTICS_SALT=

# --- Synchronisation GitHub (script local uniquement) --------------
# Optionnel : le script utilise `gh` si un token n'est pas fourni.
GITHUB_TOKEN=
GITHUB_USERNAME=Mahamadou-dev

# --- Formulaire de contact (existant) ------------------------------
NEXT_PUBLIC_WEB3FORMS_KEY=
